NEXT_PUBLIC_SITE_URL=https://upsoluti.com
# Server-only: a HTTPS n8n/CRM webhook that confirms durable receipt with 2xx.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Optional public scheduling URL, shown after confirmed delivery.
NEXT_PUBLIC_BOOKING_URL=

# 9Router (server only); root URL or /v1 are accepted.
NINEROUTER_URL=http://127.0.0.1:20128
NINEROUTER_MODEL=Atendente
NINEROUTER_KEY=
CHAT_STORAGE_PATH=.data/chat.sqlite
CHAT_RETENTION_DAYS=30
# Optional: a dedicated CRM/n8n destination for chat leads.
CHAT_LEAD_WEBHOOK_URL=
CHAT_LEAD_WEBHOOK_TOKEN=
